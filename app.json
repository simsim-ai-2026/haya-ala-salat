{
  "expo": {
    "name": "Haya ala Salat",
    "slug": "haya-ala-salat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hayaalasalat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#04251e",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0b2b22",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0b2b22"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Haya ala Salat to use your location to calculate accurate prayer times and the qibla direction."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/notification-sounds/adhan_casablanca.wav",
            "./assets/notification-sounds/adhan_doha.wav",
            "./assets/notification-sounds/adhan_kalkan.wav",
            "./assets/notification-sounds/adhan_aaqib.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
